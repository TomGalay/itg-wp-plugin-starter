<?xml version="1.0"?>
<phpunit
	bootstrap="tests/php/bootstrap-integration.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="false"
	>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/php/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
